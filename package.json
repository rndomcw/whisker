{
  "name": "whisker",
  "productName": "Whisker",
  "version": "0.4.0",
  "description": "Whisker",
  "license": "MIT",
  "author": "Wing Chu",
  "private": true,
  "main": "out/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "start": "npm run build && electron .",
    "dist": "npm run typecheck && npm run build && electron-builder --win",
    "pack": "npm run typecheck && npm run build && electron-builder --win --dir",
    "icon": "electron scripts/make-icon.js"
  },
  "build": {
    "appId": "com.whisker.logcat",
    "productName": "Whisker",
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "vendor/scrcpy",
        "to": "scrcpy"
      }
    ],
    "icon": "build/icon.png",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
